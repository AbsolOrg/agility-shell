#!/usr/bin/env bash
# =============================================================================
#  Agility Shell -- Command Line Interface (agl)
#  Main CLI tool for managing Agility Shell lifecycle and maintenance.
# =============================================================================

set -euo pipefail

VERSION="1.2.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agility-shell"
REPO_DIR=""

# Determine installation directory
if [[ -d "$CONFIG_DIR" && -f "$CONFIG_DIR/main.py" ]]; then
    REPO_DIR="$CONFIG_DIR"
else
    SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/.. 2>/dev/null && pwd || echo "")"
    if [[ -n "$SELF_DIR" && -f "$SELF_DIR/main.py" ]]; then
        REPO_DIR="$SELF_DIR"
    fi
fi

# -- Colors --------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

info()    { echo -e "${CYAN}${BOLD}[agl]${RESET} $*"; }
success() { echo -e "${GREEN}${BOLD}[agl:ok]${RESET} $*"; }
warn()    { echo -e "${YELLOW}${BOLD}[agl:warn]${RESET} $*"; }
error()   { echo -e "${RED}${BOLD}[agl:err]${RESET} $*" >&2; }
die()     { error "$*"; exit 1; }

# -- Help message --------------------------------------------------------------
show_help() {
    echo -e "${BOLD}Agility Shell CLI (agl)${RESET} - Management utility for agility-shell"
    echo -e ""
    echo -e "${BOLD}USAGE:${RESET}"
    echo -e "    agl <command> [options]"
    echo -e ""
    echo -e "${BOLD}CORE COMMANDS:${RESET}"
    echo -e "    ${CYAN}install${RESET}       Install or reinstall Agility Shell and system dependencies"
    echo -e "    ${CYAN}update${RESET}        Update Agility Shell in-place to latest version (preserves configs)"
    echo -e "    ${CYAN}uninstall${RESET}     Uninstall Agility Shell (--purge to wipe all configs and wallpapers)"
    echo -e "    ${CYAN}start${RESET}         Start Agility Shell"
    echo -e "    ${CYAN}restart${RESET}       Restart running Agility Shell instance (-f/--foreground for console logs)"
    echo -e "    ${CYAN}suits${RESET}         Manage desktop suites (list, next, prev, toggle, switch <id>)"
    echo -e ""
    echo -e "${BOLD}OPTIONS:${RESET}"
    echo -e "    ${CYAN}-h, --help${RESET}    Show this help message"
    echo -e "    ${CYAN}-v, --version${RESET} Show Agility Shell version"
    echo -e ""
    echo -e "${BOLD}EXAMPLES:${RESET}"
    echo -e "    ${DIM}# Update shell while keeping custom configs and wallpapers:${RESET}"
    echo -e "    agl update"
    echo -e ""
    echo -e "    ${DIM}# Restart the shell gracefully:${RESET}"
    echo -e "    agl restart"
    echo -e ""
    echo -e "    ${DIM}# Start the shell in foreground mode to inspect live logs:${RESET}"
    echo -e "    agl restart -f"
    echo -e ""
    echo -e "    ${DIM}# Cleanly uninstall agility-shell:${RESET}"
    echo -e "    agl uninstall"
}

cmd_install() {
    info "Launching Agility Shell installer..."
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/install.sh" ]]; then
        exec "$REPO_DIR/scripts/install.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/install.sh" ]]; then
        exec "$REPO_DIR/install.sh" "$@"
    else
        TMP_DIR="$(mktemp -d)"
        trap 'rm -rf "$TMP_DIR"' EXIT
        curl -fsSL https://raw.githubusercontent.com/AbsolOrg/agility-shell/main/scripts/install.sh -o "$TMP_DIR/install.sh"
        chmod +x "$TMP_DIR/install.sh"
        exec "$TMP_DIR/install.sh" "$@"
    fi
}

cmd_update() {
    info "Launching Agility Shell updater..."
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/update.sh" ]]; then
        exec "$REPO_DIR/scripts/update.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/update.sh" ]]; then
        exec "$REPO_DIR/update.sh" "$@"
    else
        TMP_DIR="$(mktemp -d)"
        trap 'rm -rf "$TMP_DIR"' EXIT
        curl -fsSL https://raw.githubusercontent.com/AbsolOrg/agility-shell/main/scripts/update.sh -o "$TMP_DIR/update.sh"
        chmod +x "$TMP_DIR/update.sh"
        exec "$TMP_DIR/update.sh" "$@"
    fi
}

cmd_uninstall() {
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/uninstall.sh" ]]; then
        exec "$REPO_DIR/scripts/uninstall.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/uninstall.sh" ]]; then
        exec "$REPO_DIR/uninstall.sh" "$@"
    else
        TMP_DIR="$(mktemp -d)"
        trap 'rm -rf "$TMP_DIR"' EXIT
        curl -fsSL https://raw.githubusercontent.com/AbsolOrg/agility-shell/main/scripts/uninstall.sh -o "$TMP_DIR/uninstall.sh"
        chmod +x "$TMP_DIR/uninstall.sh"
        exec "$TMP_DIR/uninstall.sh" "$@"
    fi
}

cmd_start() {
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/start.sh" ]]; then
        exec "$REPO_DIR/scripts/start.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/start.sh" ]]; then
        exec "$REPO_DIR/start.sh" "$@"
    elif [[ -d "$CONFIG_DIR" && -f "$CONFIG_DIR/main.py" ]]; then
        cd "$CONFIG_DIR"
        source "$CONFIG_DIR/venv/bin/activate" 2>/dev/null || true
        exec python3 "$CONFIG_DIR/main.py" "$@"
    else
        die "Agility Shell installation not found. Run 'agl install' first."
    fi
}

    cmd_restart() {
    if [[ -n "$REPO_DIR" && -f "$REPO_DIR/scripts/restart.sh" ]]; then
        exec "$REPO_DIR/scripts/restart.sh" "$@"
    elif [[ -n "$REPO_DIR" && -f "$REPO_DIR/restart.sh" ]]; then
        exec "$REPO_DIR/restart.sh" "$@"
    else
        die "restart script not found. Run 'agl install' first."
    fi
}

cmd_suits() {
    local action="${1:-list}"
    shift || true
    case "$action" in
        next)
            fabric-cli exec agility-shell "suits_service.cycle_next_suite()" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        prev)
            fabric-cli exec agility-shell "suits_service.cycle_prev_suite()" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        toggle)
            fabric-cli exec agility-shell "bar_manager.toggle('Suits')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            ;;
        switch)
            local target="${1:-}"
            if [[ -n "$target" ]]; then
                fabric-cli exec agility-shell "suits_service.switch_suite('$target')" 2>/dev/null || info "Shell not currently running or fabric-cli unavailable."
            else
                die "Usage: agl suits switch <desktop_id>"
            fi
            ;;
        list|*)
            python3 -c "
import json, os
p = os.path.expanduser('~/.config/agility-shell/config/suits.json')
if os.path.exists(p):
    with open(p) as f:
        d = json.load(f)
    active = d.get('active_id', '')
    for s in d.get('suites', []):
        prefix = '* ' if s.get('id') == active else '  '
        print(f\"{prefix}{s.get('name', 'Desktop')} (id: {s.get('id')})\")
else:
    print('No desktop suites configured yet.')
"
            ;;
    esac
}

# Subcommand routing
COMMAND="${1:-}"
if [[ -n "$COMMAND" ]]; then
    shift || true
fi

case "$COMMAND" in
    install)
        cmd_install "$@"
        ;;
    update)
        cmd_update "$@"
        ;;
    uninstall)
        cmd_uninstall "$@"
        ;;
    start)
        cmd_start "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    suits)
        cmd_suits "$@"
        ;;
    -v|--version|version)
        echo -e "Agility Shell CLI (agl) v$VERSION"
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        error "Unknown command: '$COMMAND'"
        echo ""
        show_help
        exit 1
        ;;
esac
